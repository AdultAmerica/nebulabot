# --- Required ---------------------------------------------------------------
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Comma-separated Telegram user IDs. These can never be revoked from chat, so
# keep at least one you control. Further admins can be added with /addadmin.
ADMIN_IDS=123456789

# --- Webhook mode (leave WEBHOOK_URL unset to run in polling mode) -----------
#WEBHOOK_URL=https://your-app.example.com/webhook
#WEBHOOK_SECRET=generate-a-long-random-string-here
#WEBHOOK_PATH=/webhook
#PORT=8000

# --- Optional ---------------------------------------------------------------
# Anything SQLAlchemy accepts. Default: sqlite:///bot.db
#DATABASE_URL=sqlite:///bot.db

# Fallback timezone for admins who have not set their own (IANA name).
#TIMEZONE=UTC

#LOG_LEVEL=INFO

# Minimum seconds between two actions from one admin.
#THROTTLE_SECONDS=0.4

# Retries for a failed send, and the longest flood-wait we will sit out.
#SEND_RETRIES=3
#MAX_RETRY_AFTER=300

# How stale a missed run may be and still be delivered after a restart.
#MISFIRE_GRACE=3600
